{
  "expo": {
    "name": "Legará",
    "slug": "legara",
    "scheme": "legara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E3E5E8",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0055BF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#E3E5E8",
          "dark": {
            "backgroundColor": "#2C2F33"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Legará uses the camera to photograph your minifigure so it can estimate its price.",
          "photosPermission": "Legará lets you pick a photo of your minifigure so it can estimate its price."
        }
      ]
    ]
  }
}
